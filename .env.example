# Copy to .env.local for local dev.
# On Cloudflare: NEXT_PUBLIC_* go in Settings → Build → Variables (needed at build time)
# AND everything goes in Settings → Variables and Secrets (runtime). Use "Secret" for keys.

# Site
NEXT_PUBLIC_SITE_URL=https://printphonecover.com

# Supabase (new project just for PrintPhoneCover)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — already set in .env.production
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key — Cloudflare Secret only, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true after turning on Stripe Tax in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false

# Google Maps Platform key with "Places API (New)" enabled.
# Server-side only (never exposed to the browser). Restrict it by API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# EasyPost (USPS address verification + shipping labels + tracking)
EASYPOST_API_KEY=
# Shared secret you also put in the EasyPost webhook URL: https://printphonecover.com/api/easypost/webhook?secret=...
EASYPOST_WEBHOOK_SECRET=

# Ship-from address (your print location)
SHIP_FROM_NAME=PrintPhoneCover
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=TX
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=

# Default parcel for one boxed case (inches / ounces)
PARCEL_LENGTH=8
PARCEL_WIDTH=5
PARCEL_HEIGHT=1.5
PARCEL_WEIGHT_OZ=5

# Resend (order emails). From address must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=PrintPhoneCover <orders@printphonecover.com>

# Admin dashboard login
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin login cookie
ADMIN_SECRET=
